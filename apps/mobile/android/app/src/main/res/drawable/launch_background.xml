<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Flutter launch screen: brand gradient + soft glow + centred mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#FF4F46E5" android:endColor="#FF9333EA"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="260dp"
                android:startColor="#33FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item android:width="200dp" android:height="200dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
