[Unit]
Description=HuanHermes Bridge Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huanhermes
Group=huanhermes
WorkingDirectory=/opt/huanhermes/server
ExecStart=/usr/bin/python3 /opt/huanhermes/server/production_host.py --config /etc/huanhermes/host.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huanhermes

[Install]
WantedBy=multi-user.target
